{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.3/.schema/devbox.schema.json",
  "packages": [
    "opentofu@latest",
    "ansible@latest",
    "talosctl@1.13.5",
    "kubectl@latest",
    "kubernetes-helm@latest",
    "yq-go@latest",
    "bat@latest",
    "argocd@latest"
  ],
  "env": {
    "LANG":   "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null",
      "alias terraform=tofu"
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}
